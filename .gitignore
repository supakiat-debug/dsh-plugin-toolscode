# dependencies (the harness provides cordis / dsh-tools at runtime;
# a node_modules here is only for running the integration tests)
node_modules/

# packaging / logs
npm-debug.log*
yarn-error.log*
*.log
*.tgz

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# local scratch and captured prompt text (real deployments contain real paths)
scratch/
tmp/
*.captured.txt

# the Hermes adapter is Python (adapters/hermes): bytecode and test caches,
# which appear the moment anyone runs test_wire.py from a clone
__pycache__/
*.py[cod]
.pytest_cache/
